# Endereco da API do Mirante.
# Em desenvolvimento com o docker compose: http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Identificador do servico que este site atende.
# E o slug do cliente cadastrado na plataforma. Trocar este valor e trocar de
# marca, de catalogo e de tabela de precos, sem mexer em uma linha de codigo.
NEXT_PUBLIC_SERVICO=cineserra

# Banco. Note o prefixo jdbc: e o sslmode=require nos provedores gerenciados.
DATABASE_URL=jdbc:postgresql://localhost:5432/outorga
DATABASE_USER=outorga
DATABASE_PASSWORD=outorga
DB_POOL_MAX=5

# DEMONSTRACAO roda sem fornecedor externo.
# PRODUCAO exige video e cobranca configurados, e recusa subir sem.
OUTORGA_MODO=DEMONSTRACAO

# Minimo de 64 caracteres. A aplicacao recusa iniciar com menos.
# Gere com: openssl rand -base64 64
JWT_SEGREDO=troque-este-segredo-de-desenvolvimento-com-no-minimo-64-caracteres-ok

URL_PUBLICA=http://localhost:8080
ORIGENS_PERMITIDAS=http://localhost:3000
LOG_LEVEL=INFO

# Video. So preencher ao sair da demonstracao.
# A escolha de partida e o Cloudflare R2, que nao cobra saida de dados.
VIDEO_ENDPOINT=
VIDEO_BUCKET=
VIDEO_CHAVE=
VIDEO_SEGREDO=
VIDEO_REGIAO=auto

# Cobranca. Comece pelo sandbox e so troque depois de ver um pagamento
# de teste percorrer o caminho inteiro.
COBRANCA_URL=https://api-sandbox.asaas.com/v3
COBRANCA_CHAVE=
COBRANCA_WEBHOOK_SEGREDO=
